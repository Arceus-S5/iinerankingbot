# Slackアプリをインストールして取得。実際の値はチャットやGitHubに貼らないでください。
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# *で全員利用可能。限定する場合はSlackメンバーIDをカンマ区切り。
# 全員利用では、Botが読める非公開チャンネル分の合計も利用者に見えます。
SLACK_ALLOWED_USER_IDS=*

# true = サーバルと同じ、自分で押した👍を除外。
# 判定に必要なユーザー一覧が省略されていた場合、ランキングの表示を中止します。
# false = 自分で押した分も含め、Slackの👍表示数を合計します。
EXCLUDE_SELF_LIKES=true

# Botが参加しているチャンネルを集計します。未参加チャンネルは除外。
# true にすると、Botが参加している非公開チャンネルも対象にします。
# Botから見えない非公開チャンネルとDMは取得できません。
INCLUDE_PRIVATE_CHANNELS=true
